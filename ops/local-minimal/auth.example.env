# Private GoTrue template: never put this file in the app/public environment.
# Disabled preparation only. Do not start a service with placeholders.
GOTRUE_API_HOST=127.0.0.1
GOTRUE_API_PORT=18001
GOTRUE_DB_DRIVER=postgres
GOTRUE_DB_DATABASE_URL=postgres://supabase_auth_admin:replace-with-private-db-password@127.0.0.1:18004/replace_with_confirmed_database?search_path=auth
GOTRUE_SITE_URL=https://replace-with-fixed-public-host.invalid
API_EXTERNAL_URL=https://replace-with-fixed-public-host.invalid/api/pc-supabase/auth/v1
GOTRUE_URI_ALLOW_LIST=https://replace-with-fixed-public-host.invalid/auth/callback
GOTRUE_JWT_SECRET=replace-with-independent-local-signing-secret
GOTRUE_JWT_AUD=authenticated
GOTRUE_JWT_DEFAULT_GROUP_NAME=authenticated
GOTRUE_JWT_ADMIN_ROLES=service_role
GOTRUE_DISABLE_SIGNUP=true
GOTRUE_EXTERNAL_EMAIL_ENABLED=false
GOTRUE_EXTERNAL_PHONE_ENABLED=false
GOTRUE_EXTERNAL_ANONYMOUS_USERS_ENABLED=false
GOTRUE_EXTERNAL_GOOGLE_ENABLED=false
GOTRUE_EXTERNAL_GOOGLE_CLIENT_ID=replace-with-reviewed-existing-client-id
GOTRUE_EXTERNAL_GOOGLE_SECRET=replace-from-existing-private-file
GOTRUE_EXTERNAL_GOOGLE_REDIRECT_URI=https://replace-with-fixed-public-host.invalid/api/pc-supabase/auth/v1/callback
GOTRUE_HOOK_BEFORE_USER_CREATED_ENABLED=true
GOTRUE_HOOK_BEFORE_USER_CREATED_URI=pg-functions://postgres/public/hook_restrict_signup_by_email_domain
# Enable Google and set DISABLE_SIGNUP=false only after authoritative identities,
# hook permissions/allowlist and the fixed HTTPS callback pass acceptance. Keeping
# DISABLE_SIGNUP=true blocks permitted Google users with no existing Auth row.
