[Unit]
Description=TUAT named Cloudflare ingress transport
Wants=network-online.target
After=network-online.target tuat-local-app.service
ConditionPathIsMountPoint=/var/lib/tuat-local

[Service]
Type=exec
User=65532
Group=65532
Environment=HOME=/nonexistent PATH=/usr/bin:/bin
LoadCredential=token:/var/lib/tuat-local/private/tunnel.token
LoadCredential=config:/var/lib/tuat-local/private/tunnel.yml
ExecStartPre=+/usr/bin/findmnt --noheadings --mountpoint /var/lib/tuat-local --source /dev/mapper/tuat-local-data --types ext4
ExecStartPre=+/usr/bin/python3 -I /opt/tuat-local-runtime/transport.py --preflight
ExecStart=/usr/local/bin/cloudflared tunnel --config %d/config --no-autoupdate --protocol quic --metrics 127.0.0.1:18305 --loglevel warn run --token-file %d/token
Restart=on-failure
RestartSec=10s
TimeoutStartSec=30s
TimeoutStopSec=30s
KillMode=control-group
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
InaccessiblePaths=/var/lib/tuat-local
LimitCORE=0
UMask=0077
StandardOutput=null
StandardError=null

[Install]
WantedBy=multi-user.target
