# Separate release only. Do not load this into the current production deployment.
PC_APP_RUNTIME=true
NEXT_PUBLIC_PC_APP_RUNTIME=true
PC_LOCAL_RUNTIME=true
NEXT_PUBLIC_PC_LOCAL_RUNTIME=true
PC_BACKEND_ENABLED=true
NEXT_PUBLIC_PC_BACKEND=true
APP_PUBLIC_ORIGIN=https://replace-with-fixed-public-host.invalid
NEXT_PUBLIC_SUPABASE_URL=https://replace-with-fixed-public-host.invalid/api/pc-supabase
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-server-only-service-key
PC_LOCAL_AUTH_URL=http://127.0.0.1:18001
PC_LOCAL_REST_URL=http://127.0.0.1:18002
IMAGE_STORAGE_DRIVER=local
LOCAL_IMAGE_STORAGE_ROOT=/var/lib/tuat-local/images
LOCAL_IMAGE_SIGNING_KEY=replace-with-independent-random-server-only-key
LOCAL_IMAGE_MAX_STORAGE_BYTES=8000000000
IMAGE_STORAGE_READ_ONLY=false
R2_READ_ENABLED=false
R2_WRITE_ENABLED=false
VERCEL_GIT_COMMIT_SHA=replace-with-exact-candidate-commit
PC_APP_RELEASE_ID=replace-with-distinct-release-id
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=replace-with-fixed-canonical-base64-32bytes
NEXT_PUBLIC_UNIVERSITY_DOMAIN=replace-with-current-domain
LOCAL_WEB_PUSH_ENABLED=false
# Omit every NEXT_PUBLIC_CLOUD_AUTH_* setting, PC_BACKEND_INTERNAL_URL, external relay,
# and every R2_* credential. Off-PC backup credentials belong to its separate owner.
# Retain reviewed Google/Drive/Sheets/Push settings; do not activate Jobs yet.
