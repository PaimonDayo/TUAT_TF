PC_APP_RUNTIME=true
NEXT_PUBLIC_PC_APP_RUNTIME=true
PC_BACKEND_ENABLED=true
NEXT_PUBLIC_PC_BACKEND=true
APP_PUBLIC_ORIGIN=https://replace-with-fixed-public-host.invalid
NEXT_PUBLIC_SUPABASE_URL=https://replace-with-fixed-public-host.invalid/api/pc-supabase
PC_BACKEND_INTERNAL_URL=http://127.0.0.1:8000
NEXT_PUBLIC_CLOUD_AUTH_URL=https://replace-with-cloud-project.supabase.co
NEXT_PUBLIC_CLOUD_AUTH_ANON_KEY=replace-with-existing-cloud-public-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-existing-PC-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-existing-PC-service-key
VERCEL_GIT_COMMIT_SHA=replace-with-exact-candidate-commit
PC_APP_RELEASE_ID=replace-with-distinct-release-id
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=replace-with-fixed-canonical-base64-32bytes
NEXT_PUBLIC_UNIVERSITY_DOMAIN=replace-with-current-domain
R2_READ_ENABLED=true
R2_WRITE_ENABLED=true
IMAGE_STORAGE_READ_ONLY=false
R2_ACCOUNT_ID=replace-with-existing-account-id
R2_ACCESS_KEY_ID=replace-with-existing-key
R2_SECRET_ACCESS_KEY=replace-with-existing-secret
R2_BUCKET_NAME=replace-with-existing-bucket
# Preserve effective uploads-paused and capacity settings; never force-enable.
# Preserve current Sheets/GAS/Drive/Push and token-encryption values from verified sources.
# No defaults here for provider secrets or trigger activation.
# PC_APP_BACKUP_* are generated and injected by the owning host at each startup.
# Keep the backup encryption key and dedicated backup environment outside this app environment.
