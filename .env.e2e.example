# Copy to .env.e2e.local and use only a dedicated staging Supabase project.
E2E_BASE_URL=https://your-staging-app.vercel.app
E2E_EXPECTED_SUPABASE_REF=your_staging_project_ref
E2E_ALLOW_MUTATION=true
NEXT_PUBLIC_SUPABASE_URL=https://your_staging_project_ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_staging_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_staging_service_role_key
NEXT_PUBLIC_UNIVERSITY_DOMAIN=st.go.tuat.ac.jp

# Optional. Windows defaults to installed Microsoft Edge; CI uses bundled Chromium.
# PLAYWRIGHT_CHANNEL=msedge